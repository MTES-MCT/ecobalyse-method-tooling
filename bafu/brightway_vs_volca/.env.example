# --- ecobalyse Brightway side (y-anchor) ---
BRIGHTWAY2_DIR=/home/dadafkas/Prelab/ecobalyse/brightway-dirs/2392-EF3.1_1.03
EB_PROJECT=ecobalyse
EB_DATABASE=BAFU 2026v1
EB_METHOD=Environmental Footprint 3.1 (adapted)

# --- VoLCA engine (series) ---
# The tool starts VoLCA itself on this port (dedicated, so it never collides with :8080).
VOLCA_PORT=8091
VOLCA_DB=bafu-2026v1
# Same SimaPro CSV as ecobalyse -> identical base on both sides (isolates engine + method coverage).
BAFU_DB_PATH=/home/dadafkas/Prelab/ecobalyse/dbfiles/BAFU2026v1.CSV.zip
# Base config providing the EF method collections + curated flow synonyms/compartments/units.
VOLCA_CONFIG_BASE=/home/dadafkas/projets/VoLCA/volca-deploy/volca/examples/volca-bafu.toml
# Optional prebuilt binary; if unset, volca.download() fetches a compatible one.
# Use engine >= 0.9.1 (paired with pyvolca >= 0.7.2, wire 2): 0.9.0 silently ignores
# --exclude-long-term on the bulk endpoint, so the noLT categories would not collapse.
# VOLCA_BINARY=/home/dadafkas/projets/VoLCA/volca-deploy/dist-newstyle/.../volca

# VoLCA collections to plot (y-series), one per line-item, comma-separated.
# 1.03 = same method as ecobalyse (agreement). Add 1.05 to expose the 1.03 Water Use gap, or
# the "ecobalyse" collection (1.03 + the uraniumFRU patch) for an armes-égales run paired with
# --exclude-long-term (see volca-bafu.toml):
#   VOLCA_COLLECTIONS=Environmental Footprint 3.1 (adapted 1.03),Environmental Footprint 3.1 (adapted 1.05)
#   VOLCA_COLLECTIONS=Environmental Footprint 3.1 (adapted 1.03, ecobalyse)
VOLCA_COLLECTIONS=Environmental Footprint 3.1 (adapted 1.03)
